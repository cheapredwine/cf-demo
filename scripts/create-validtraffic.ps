# Generate valid API traffic for PeakCart API Shield demos
# Uses rotating Authorization headers to trigger API discovery

$baseUrl = "https://jsherron.com/api"

1..100 | ForEach-Object {
    # Generate a unique auth token for this batch (simulates different users)
    $authToken = "Bearer batch{0:D3}-$([Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("user$_"))).Substring(0,20)" -f $_
    $headers = @{ "Authorization" = $authToken }
    
    Invoke-RestMethod "$baseUrl/api/v1/products" -Headers $headers | Out-Null
    Invoke-RestMethod "$baseUrl/api/v1/products?category=electronics" -Headers $headers | Out-Null
    Invoke-RestMethod "$baseUrl/api/v1/products/1" -Headers $headers | Out-Null
    Invoke-RestMethod "$baseUrl/api/v1/products/2" -Headers $headers | Out-Null
    Invoke-RestMethod "$baseUrl/api/v1/products/3" -Headers $headers | Out-Null
    Invoke-RestMethod "$baseUrl/api/v1/cart/add" -Method POST -ContentType "application/json" -Headers $headers -Body '{"product_id": 1, "quantity": 2}' | Out-Null
    Invoke-RestMethod "$baseUrl/api/v1/cart/add" -Method POST -ContentType "application/json" -Headers $headers -Body '{"product_id": 3, "quantity": 1}' | Out-Null
    Invoke-RestMethod "$baseUrl/api/v1/cart/add" -Method POST -ContentType "application/json" -Headers $headers -Body '{"product_id": 5, "quantity": 4}' | Out-Null
    Invoke-RestMethod "$baseUrl/api/v1/health" -Headers $headers | Out-Null
    
    Start-Sleep -Milliseconds 500
    Write-Host "Batch $_ of 100 sent (Auth: $($authToken.Substring(0,30))...)"
}
